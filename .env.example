# Copy to .env and fill in. Never commit real secrets.

# --- Gemini 3 model ---------------------------------------------------------
GEMINI_MODEL=gemini-3-pro-preview

# Use Vertex AI (recommended for Cloud Run) or Google AI Studio key.
# Vertex:
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Or AI Studio instead of Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-key

# --- Dynatrace MCP server ---------------------------------------------------
# Verify exact variable names against the dynatrace-mcp-server version you use.
DT_ENVIRONMENT=https://YOUR-TENANT.apps.dynatrace.com
DT_PLATFORM_TOKEN=
# Or OAuth client credentials instead of a platform token:
DT_OAUTH_CLIENT_ID=
DT_OAUTH_CLIENT_SECRET=

# --- WordPress / WooCommerce MCP server -------------------------------------
WP_API_URL=https://your-store.example.com
WP_API_USERNAME=your-wp-username
WP_API_PASSWORD=your-wordpress-application-password
WOO_CUSTOMER_KEY=
WOO_CUSTOMER_SECRET=

# --- Safety -----------------------------------------------------------------
# Keep TRUE so write actions require explicit human approval.
REQUIRE_APPROVAL=true

# --- Self-instrumentation (agent -> Dynatrace via OTLP) ---------------------
# Exports the agent's own traces/metrics to Dynatrace. Optional.
# Install the extra first:  pip install '.[telemetry]'
TELEMETRY_ENABLED=true
# Dynatrace OTLP base (note: .live.dynatrace.com, not .apps):
DT_OTLP_ENDPOINT=https://YOUR-ENV-ID.live.dynatrace.com/api/v2/otlp
# API token with scopes: openTelemetryTrace.ingest, metrics.ingest
DT_OTLP_TOKEN=dt0c01.XXXXXXXX
OTEL_SERVICE_NAME=self-healing-storefront-agent
OTEL_SERVICE_VERSION=0.1.0
